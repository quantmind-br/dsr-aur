# Maintainer: quantmind-br <dsrodrigues20@gmail.com>
pkgname=dsr-aur-client
pkgver=1.0.0
pkgrel=1
pkgdesc='Checks dsr-aur packages after pacman transactions and requests rebuilds'
arch=('any')
url='https://aur.quantforge.com.br'
license=('MIT')
depends=('bash' 'binutils' 'curl' 'glibc' 'libnotify' 'openssh' 'pacman')
install=dsr-aur-client.install
source=('dsr-aur-check'
        'dsr-aur-check.hook'
        'dsr-aur-check.path'
        'dsr-aur-check.service')
sha256sums=('4ddc06788593279036349b25163c9f1b57f4e78860814208015592bcb5db31a2'
            '9ff5354ac2e03f8d3709816997f453082a21facd398cef5a12f81358232c5437'
            'bcc7ea61c563fd618769342fdd02e7ff7036f13aa43922fc3e2c2c4493397bce'
            '613c4d57455767b153acdddb1630f9ad89124137c32e6e3e4349744b94e4a07c')

package() {
  install -Dm755 dsr-aur-check -t "$pkgdir/usr/bin"
  install -Dm644 dsr-aur-check.hook -t "$pkgdir/usr/share/libalpm/hooks"
  install -Dm644 dsr-aur-check.path dsr-aur-check.service -t "$pkgdir/usr/lib/systemd/user"
  install -dm755 "$pkgdir/var/lib/dsr-aur-check"
}
