# Maintainer: quantmind-br <dsrodrigues20@gmail.com>
pkgname=dsr-gridcraft-git
_name=gridcraft
_branch=localization
pkgver=0.6.1.r1020.gc5ac8c7
pkgrel=1
pkgdesc='Clean-room Excel-style spreadsheet in Rust, localization branch of the quantmind-br fork: local formulas and regional formats (built from git)'
arch=('x86_64')
url='https://github.com/quantmind-br/gridcraft'
license=('Apache-2.0' 'MIT')
# eframe/wgpu/winit load the windowing and GPU libraries at run time (dlopen).
depends=('glibc' 'libgcc' 'hicolor-icon-theme' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'libglvnd')
makedepends=('cargo' 'git')
optdepends=('noto-fonts: interface font'
            'ttf-liberation: cell font'
            'noto-fonts-cjk: Chinese, Japanese and Korean text'
            'libx11: X11 fallback'
            'libxcursor: X11 fallback'
            'libxi: X11 fallback'
            'libxrandr: X11 fallback'
            'xdg-desktop-portal: file open and save dialogs')
provides=("$_name=${pkgver%%.r*}")
conflicts=("$_name" "$_name-bin" "$_name-git" 'dsr-gridcraft' 'dsr-gridcraft-bin')
source=("$_name::git+$url.git#branch=$_branch")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  # The fork does not carry upstream's release tags; the workspace version names the release
  # the branch is based on.
  local version
  version=$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\(.*\)"/\1/p' Cargo.toml)
  printf '%s.r%s.g%s' "${version//-/_}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name"
  CARGO_TARGET_DIR=target cargo build --frozen --release -p gridcraft -p gridcraft-cli
}

package() {
  cd "$_name"
  install -Dm755 "target/release/$_name" "target/release/$_name-cli" -t "$pkgdir/usr/bin"
  install -Dm644 "packaging/linux/ai.storyteller.$_name.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 "packaging/linux/ai.storyteller.$_name.mime.xml" "$pkgdir/usr/share/mime/packages/ai.storyteller.$_name.xml"
  local icon
  for icon in assets/app-icon/hicolor/*/apps/"ai.storyteller.$_name".{png,svg}; do
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/${icon#assets/app-icon/}"
  done
  install -Dm644 LICENSE-APACHE LICENSE-MIT NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
